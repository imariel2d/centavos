# Copy to deploy/.env on the droplet and fill in.
# DO NOT commit deploy/.env (already gitignored).

# ──────────────── Domain / URLs ───────────────────────────────
# DOMAIN must point at the droplet's public IP (A record).
# Caddy uses it to fetch a Let's Encrypt cert.
DOMAIN=cms.centavos.mx
PUBLIC_URL=https://cms.centavos.mx
CORS_ORIGIN=https://centavos.mx,https://*.vercel.app

# ──────────────── Directus identity ───────────────────────────
# Generate two random 32-byte hex strings:
#   openssl rand -hex 32
KEY=
SECRET=

# ──────────────── Admin user (first boot only) ────────────────
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=

# ──────────────── Postgres ────────────────────────────────────
DB_USER=directus
DB_NAME=directus
DB_PASSWORD=

# ──────────────── Optional: AWS S3 for uploads ────────────────
# Default is "local" (Docker volume on this droplet, persists across
# container restarts but stays on this single VM). Set to "s3" + the
# four S3_* values if you want uploads in AWS S3.
# STORAGE_LOCATIONS=s3
# STORAGE_S3_KEY=AKIA...
# STORAGE_S3_SECRET=
# STORAGE_S3_BUCKET=centavos-cms-uploads
# STORAGE_S3_REGION=us-east-1
