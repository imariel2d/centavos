
NEXT_PUBLIC_SITE_URL=https://centavo.mx
DIRECTUS_URL=http://localhost:8055
CONTACT_EMAIL=hola@centavo.mx

# Lectores al mes — mostrado en "Centavo en números" en /nosotros.
# Si está vacío, esa cifra se oculta. Reemplaza cuando conectes analytics.
# READERS_PER_MONTH=42k

# AWS S3 — solo si quieres correr el Directus local con storage en S3
# (para paridad con prod). Por default, el local usa el volumen de Docker.
# STORAGE_LOCATIONS=s3
# STORAGE_S3_KEY=
# STORAGE_S3_SECRET=
# STORAGE_S3_BUCKET=centavos-cms-uploads
# STORAGE_S3_REGION=us-east-1