# URL canónica del sitio en producción (sin slash final)
NEXT_PUBLIC_SITE_URL=https://centavo.mx

# ──────────────── CMS (cuando lo conectes) ────────────────
# Sanity
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN=

# Contentful
# CONTENTFUL_SPACE_ID=
# CONTENTFUL_ACCESS_TOKEN=

# Strapi
# STRAPI_API_URL=
# STRAPI_API_TOKEN=

# Directus (local docker-compose)
DIRECTUS_URL=http://localhost:8055
# DIRECTUS_TOKEN=                # only if you remove public read perms
# ADMIN_EMAIL=admin@centavo.mx   # used by directus/bootstrap.mjs + seed.mjs
# ADMIN_PASSWORD=admin
